# Database Connection
MONGO_DB="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=VasoolX&retryWrites=true&w=majority"

# JWT Authentication
JWT_SECRET="your_jwt_secret_here"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Optional Base URL override (defaults to /api in web)
NEXT_PUBLIC_API_URL="/api"
